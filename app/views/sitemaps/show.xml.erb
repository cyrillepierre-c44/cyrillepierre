<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<% SitemapsController::STATIC_PAGES.each do |page| %>
  <url>
    <loc><%= canonical_url(send(page[:path])) %></loc>
    <lastmod><%= @site_updated_at.utc.iso8601 %></lastmod>
    <changefreq><%= page[:changefreq] %></changefreq>
    <priority><%= page[:priority] %></priority>
  </url>
<% end %>
<% @actus.each do |actu| %>
  <url>
    <loc><%= canonical_url(actu_path(actu)) %></loc>
    <lastmod><%= actu.updated_at.utc.iso8601 %></lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.6</priority>
  </url>
<% end %>
</urlset>
