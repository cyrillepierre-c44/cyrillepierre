  function applyLang(lang) {
    var t = TRANSLATIONS[lang] || TRANSLATIONS['fr'];
    for (var id in t) {
      var el = document.getElementById(id);
      if (el) el.innerHTML = t[id];
    }
    updatePaperBtn();
    document.documentElement.lang = lang === 'en' ? 'en' : 'fr';
  }

  var page    = document.querySelector('.page');
  var wrapper = document.querySelector('.page-wrapper');

  function scalePage() {
    var vw = window.innerWidth;
    if (vw < 830) {
      var scale = (vw - 8) / 794;
      page.style.transform       = 'scale(' + scale + ')';
      page.style.transformOrigin = 'top left';
      page.style.marginLeft      = '4px';
      wrapper.style.height       = (page.offsetHeight * scale) + 'px';
      wrapper.style.overflow     = 'hidden';
    } else {
      clearScale();
    }
  }

  function clearScale() {
    page.style.transform       = '';
    page.style.transformOrigin = '';
    page.style.marginLeft      = '';
    wrapper.style.height       = '';
    wrapper.style.overflow     = '';
  }

  document.addEventListener('DOMContentLoaded', function() {
    scalePage();
    var params = new URLSearchParams(window.location.search);
    if (params.get('mode') === 'papier') {
      document.body.classList.add('paper-mode');
      updatePaperBtn();
    }
    if (params.get('lang') === 'en') {
      document.getElementById('langSelect').value = 'en';
      applyLang('en');
    }
  });

  window.addEventListener('resize', scalePage);
  window.addEventListener('beforeprint', clearScale);
  window.addEventListener('afterprint',  scalePage);

  var printMQ = window.matchMedia('print');
  if (printMQ.addEventListener) {
    printMQ.addEventListener('change', function(mq) {
      mq.matches ? clearScale() : scalePage();
    });
  }
</script>
