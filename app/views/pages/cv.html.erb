<body>
<div class="btn-bar">
  <a href="/" class="cv-btn" id="cv-btn-home">← Accueil</a>
  <select class="print-quality" id="langSelect" title="Langue / Language" onchange="applyLang(this.value)">
    <option value="fr">Français</option>
    <option value="en">English</option>
  </select>
  <select class="print-quality" id="printQuality" title="Qualité du PDF généré à l'impression">
    <option value="standard" id="cv-quality-standard">Qualité standard</option>
    <option value="compact" id="cv-quality-compact">Compacte (poids réduit)</option>
  </select>
  <button class="cv-btn" id="cv-btn-print" onclick="window.print()">⎙ Imprimer</button>
  <button class="cv-btn paper" id="cv-btn-paper" onclick="togglePaper()">🖨 Version papier</button>
  <button class="cv-btn" id="cv-btn-share" onclick="shareCV(this)">↗ Partager</button>
</div>
<script>
  var PHOTO_STANDARD_SRC = "/images/cyrille.jpg";
  var PHOTO_COMPACT_SRC = "/images/cyrille-print-compact.jpg";

  function useCompactPrintQuality() {
    var select = document.getElementById('printQuality');
    return select && select.value === 'compact';
  }

  function setPrintPhoto() {
    var photo = document.querySelector('.photo-wrapper img');
    if (photo) photo.src = useCompactPrintQuality() ? PHOTO_COMPACT_SRC : PHOTO_STANDARD_SRC;
  }

  function restoreScreenPhoto() {
    var photo = document.querySelector('.photo-wrapper img');
    if (photo) photo.src = PHOTO_STANDARD_SRC;
  }

  window.addEventListener('beforeprint', setPrintPhoto);
  window.addEventListener('afterprint', restoreScreenPhoto);

  function togglePaper() {
    document.body.classList.toggle('paper-mode');
    updatePaperBtn();
  }

  function updatePaperBtn() {
    var btn = document.getElementById('cv-btn-paper');
    var lang = document.getElementById('langSelect').value;
    var isPaper = document.body.classList.contains('paper-mode');
    if (lang === 'en') {
      btn.textContent = isPaper ? '🎨 Colour version' : '🖨 Paper version';
    } else {
      btn.textContent = isPaper ? '🎨 Version couleur' : '🖨 Version papier';
    }
  }

  function shareCV(btn) {
    var isPaper = document.body.classList.contains('paper-mode');
    var lang = document.getElementById('langSelect').value;
    var params = [];
    if (isPaper) params.push('mode=papier');
    if (lang === 'en') params.push('lang=en');
    var query = params.length ? '?' + params.join('&') : '';
    var url = window.location.origin + window.location.pathname + query;
    var copiedMsg = lang === 'en' ? '✓ Link copied!' : '✓ Lien copié !';
    if (navigator.share) {
      navigator.share({ title: 'CV — Cyrille PIERRE', url: url });
    } else {
      navigator.clipboard.writeText(url).then(function() {
        var orig = btn.textContent;
        btn.textContent = copiedMsg;
        setTimeout(function() { btn.textContent = orig; }, 2000);
      });
    }
  }
</script>
