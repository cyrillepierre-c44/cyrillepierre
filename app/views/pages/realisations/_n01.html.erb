<svg viewBox="0 0 480 200" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00d4ff" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.9"/>
              </linearGradient>
              <linearGradient id="g1bar" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#00d4ff" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.85"/>
              </linearGradient>
            </defs>
            <rect width="480" height="200" fill="#050a15"/>
            <%# Étiquette axe Y %>
            <text x="105" y="18" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="sans-serif" letter-spacing="2">TRS</text>
            <%# Axe Y : 50% à 70%, y=160→y=30, 1%=6.5px %>
            <%# Gridline 60% %>
            <line x1="30" y1="95" x2="205" y2="95" stroke="rgba(148,163,184,0.08)" stroke-width="1" stroke-dasharray="3,3"/>
            <text x="27" y="98" text-anchor="end" fill="rgba(148,163,184,0.35)" font-size="8" font-family="sans-serif">60%</text>
            <%# Axe bas 50% %>
            <line x1="30" y1="160" x2="205" y2="160" stroke="rgba(148,163,184,0.15)" stroke-width="1"/>
            <text x="27" y="163" text-anchor="end" fill="rgba(148,163,184,0.35)" font-size="8" font-family="sans-serif">50%</text>
            <%# Barre Avant 57% %>
            <rect x="45" y="115" width="52" height="45" rx="4" fill="rgba(148,163,184,0.18)" stroke="rgba(148,163,184,0.25)" stroke-width="1"/>
            <text x="71" y="143" text-anchor="middle" fill="#94a3b8" font-size="13" font-family="sans-serif" font-weight="600">57%</text>
            <text x="71" y="174" text-anchor="middle" fill="rgba(148,163,184,0.5)" font-size="9" font-family="sans-serif">Avant</text>
            <%# Barre Après 65% %>
            <rect x="113" y="63" width="52" height="97" rx="4" fill="url(#g1bar)"/>
            <text x="139" y="116" text-anchor="middle" fill="white" font-size="13" font-family="sans-serif" font-weight="600">65%</text>
            <text x="139" y="174" text-anchor="middle" fill="rgba(0,212,255,0.6)" font-size="9" font-family="sans-serif">Après</text>
            <%# Annotation +8% bien au-dessus de la barre %>
            <text x="139" y="43" text-anchor="middle" fill="#00d4ff" font-size="12" font-family="sans-serif" font-weight="bold">+8%</text>
            <polygon points="139,48 136,56 142,56" fill="#00d4ff" opacity="0.8"/>
            <%# Séparateur %>
            <line x1="218" y1="15" x2="218" y2="178" stroke="rgba(0,212,255,0.07)" stroke-width="1"/>
            <%# Section droite : ⚙️ + 👥 → 🤝 %>
            <text x="268" y="95" text-anchor="middle" font-size="30">⚙️</text>
            <text x="306" y="92" text-anchor="middle" font-size="26">👥</text>
            <text x="347" y="98" text-anchor="middle" fill="url(#g1)" font-size="22" font-family="sans-serif">→</text>
            <text x="390" y="95" text-anchor="middle" font-size="30">🤝</text>
            <%# Montant %>
            <text x="323" y="158" text-anchor="middle" fill="url(#g1)" font-size="16" font-weight="bold" font-family="sans-serif">480 K€/an</text>
            <line x1="0" y1="190" x2="480" y2="190" stroke="rgba(0,212,255,0.08)" stroke-width="1"/>
          </svg>
