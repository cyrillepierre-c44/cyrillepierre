<% content_for :title, (@actu.title.presence || "Actu") + " — Cyrille PIERRE" %>
<% content_for :description, @actu.output.to_s.squish.truncate(155) %>
<% content_for :head do %><%= structured_data_tag(actu_schema(@actu)) %><% end %>

<section class="service-hero">
  <div class="container">
    <%# Une actu publiée porte normalement sa date, mais rien en base ne l'impose : une valeur
   manquante ne doit pas faire tomber une page publique. %>
    <span class="section-eyebrow"><%= (@actu.published_at || @actu.updated_at).strftime("%d/%m/%Y") %></span>
    <h1><%= @actu.title.presence || "Actualité" %></h1>
  </div>
</section>

<div class="container pb-5">
  <div class="actu-body">
    <%= simple_format(@actu.output) %>
  </div>

  <%= link_to "← Toutes les actus", actus_path, class: "studio-back-link" %>
</div>
