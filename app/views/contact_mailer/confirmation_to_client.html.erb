  <div class="card">
    <div class="logo">CP</div>

    <h1>Bonjour <%= @name %>,</h1>
    <p class="subtitle">
      Votre demande a bien été reçue. Je vous recontacte sous 24h pour convenir d'un premier échange.
    </p>

    <div class="themes">
      <% @themes.each do |theme| %>
        <span class="badge"><%= theme %></span>
      <% end %>
    </div>

    <div class="section">
      <div class="label">Résumé de votre demande</div>
      <div class="summary-box"><%= @summary %></div>
    </div>

    <hr>

    <div class="section">
      <div class="label">Mes coordonnées</div>
      <div class="contact-block">
        <div class="contact-line"><strong><%= SiteIdentity::NAME %></strong> — Consultant Indépendant</div>
        <div class="contact-line">Ingénieur Arts & Métiers · Lyon</div>
        <div class="contact-line">📧 <a href="mailto:<%= SiteIdentity::EMAIL %>"><%= SiteIdentity::EMAIL %></a></div>
        <div class="contact-line">📞 <%= SiteIdentity::PHONE_DISPLAY %></div>
        <div class="contact-line">🔗 <a href="<%= SiteIdentity::LINKEDIN_URL %>"><%= SiteIdentity::LINKEDIN_URL.delete_prefix("https://www.") %></a></div>
      </div>
    </div>

    <p class="footer">
      Ce message a été envoyé depuis <a href="<%= SiteIdentity::HOST %>">cyrillepierre.com</a>
    </p>
  </div>
