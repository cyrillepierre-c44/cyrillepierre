<%= form_for generation, url: url,
              html: { multipart: true,
                      data: { controller: "studio-generation", turbo: false, action: "submit->studio-generation#submitting" } } do |f| %>
  <%= render "devise/shared/error_messages", resource: generation %>

  <%# Le rattachement vient de l'adresse et doit survivre à l'envoi du formulaire, sinon le
      prompt ne saura plus quel article le post doit faire lire. %>
  <%= f.hidden_field :source_article_id %>

  <% if generation.source_article.present? %>
    <p class="studio-field-hint">
      Ce post annoncera l'article « <%= generation.source_article.display_title %> » et se terminera par son lien.
    </p>
  <% end %>

  <%= render "studio/shared/progress_overlay", text: "Génération en cours…", text_target: true,
             hint: "Ça peut prendre jusqu'à une minute selon la source fournie." %>

  <div class="studio-card">
    <h2 class="studio-card-subtitle">1. Type de contenu</h2>
    <div class="cf-themes-grid studio-kind-grid">
      <label class="cf-theme-card">
        <%= f.radio_button :kind, "linkedin_post", checked: generation.kind.blank? || generation.linkedin_post?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">💼</span>
          <h3 class="cf-theme-title">Post LinkedIn</h3>
          <p class="cf-theme-desc">Un post court et percutant à partir d'une source</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>

      <label class="cf-theme-card">
        <%= f.radio_button :kind, "cover_letter", checked: generation.cover_letter?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">✉️</span>
          <h3 class="cf-theme-title">Lettre de motivation</h3>
          <p class="cf-theme-desc">Ciblée sur une offre d'emploi ou de mission précise</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>

      <label class="cf-theme-card">
        <%= f.radio_button :kind, "commercial_proposal", checked: generation.commercial_proposal?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">📋</span>
          <h3 class="cf-theme-title">Proposition commerciale</h3>
          <p class="cf-theme-desc">En réponse à un brief client</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>

      <label class="cf-theme-card">
        <%= f.radio_button :kind, "site_actu", checked: generation.site_actu?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">📰</span>
          <h3 class="cf-theme-title">Actu du site</h3>
          <p class="cf-theme-desc">Une brève publiable sur /actus</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>

      <label class="cf-theme-card">
        <%= f.radio_button :kind, "executive_brief", checked: generation.executive_brief?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">📑</span>
          <h3 class="cf-theme-title">Note de diagnostic dirigeant</h3>
          <p class="cf-theme-desc">Les comptes reliés au terrain, sans l'ordonnance — pour un PDG ou un board</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>

      <label class="cf-theme-card">
        <%= f.radio_button :kind, "article", checked: generation.article?,
                            data: { action: "change->studio-generation#selectKind" } %>
        <div class="cf-theme-inner">
          <span class="cf-theme-icon">📖</span>
          <h3 class="cf-theme-title">Article de fond</h3>
          <p class="cf-theme-desc">800 à 1200 mots qui répondent à une question précise</p>
          <span class="cf-theme-check"><i class="fa-solid fa-check"></i></span>
        </div>
      </label>
    </div>
  </div>

  <%# L'ordre suit la pensée de celui qui remplit, pas l'histoire du code : ce que j'écris, à partir
      de quoi, comment, sous quel titre, avec quel modèle. Le formulaire avait été bâti pour le post
      LinkedIn et posait l'orientation et le modèle avant la source. %>
  <div class="studio-card">
    <h2 class="studio-card-subtitle">2. Source</h2>

    <div class="studio-source-tabs" role="tablist">
      <button type="button" class="studio-source-tab studio-source-tab--active"
              data-studio-generation-target="tabButton" data-source="text"
              data-action="click->studio-generation#selectSource">Texte collé</button>
      <button type="button" class="studio-source-tab"
              data-studio-generation-target="tabButton" data-source="file"
              data-action="click->studio-generation#selectSource">Fichier</button>
      <button type="button" class="studio-source-tab"
              data-studio-generation-target="tabButton" data-source="url"
              data-action="click->studio-generation#selectSource">URL</button>
    </div>

    <div class="cf-field studio-source-panel" data-studio-generation-target="sourcePanel" data-source="text">
      <%= f.text_area :input_text, class: "cf-input cf-textarea", rows: 8, placeholder: "Colle ici le texte source (brief, offre d'emploi, notes…)" %>
      <%# Une aide par type, la bonne étant affichée par le contrôleur Stimulus selon le type coché. %>
      <p class="studio-field-hint" data-studio-generation-target="sourceHint" data-kinds="linkedin_post">
        Laisse vide pour que l'IA invente un post à partir du profil de Cyrille (CV, réalisations), ou colle un brief, un article, des notes.
      </p>
      <p class="studio-field-hint d-none" data-studio-generation-target="sourceHint" data-kinds="cover_letter">
        Colle l'offre d'emploi ou de mission : la lettre s'écrit contre elle.
      </p>
      <p class="studio-field-hint d-none" data-studio-generation-target="sourceHint" data-kinds="commercial_proposal">
        Colle le brief client — il est pré-rempli quand tu viens d'une fiche prospect.
      </p>
      <p class="studio-field-hint d-none" data-studio-generation-target="sourceHint" data-kinds="executive_brief">
        Le brief prospect est pré-rempli depuis la fiche : c'est le contexte, à laisser tel quel.
        L'<strong>analyse financière validée</strong> se colle dans le bloc 6, en bas, pas ici.
      </p>
      <p class="studio-field-hint d-none" data-studio-generation-target="sourceHint" data-kinds="site_actu article">
        Colle la matière (notes, source, question à traiter), ou laisse vide pour partir du catalogue de réalisations.
      </p>
    </div>

    <div class="cf-field studio-source-panel d-none" data-studio-generation-target="sourcePanel" data-source="file">
      <%= f.file_field :source_file, class: "cf-input", accept: ".txt,.md,.pdf" %>
      <p class="studio-field-hint">Formats acceptés : .txt, .md, .pdf — 10 Mo maximum</p>
    </div>

    <div class="cf-field studio-source-panel d-none" data-studio-generation-target="sourcePanel" data-source="url">
      <%= f.url_field :input_url, class: "cf-input", placeholder: "https://exemple.com/offre-emploi" %>
    </div>
  </div>

  <div class="studio-card">
    <h2 class="studio-card-subtitle">3. Précisions</h2>

    <%# L'orientation ne change le ton que des contenus publics : la montrer pour une lettre ou une
        note posait une question sans objet. %>
    <div class="cf-field d-none" data-studio-generation-target="orientationField" data-kinds="linkedin_post site_actu article">
      <%= f.label :orientation, "Orientation", class: "cf-label" %>
      <%= f.select :orientation,
                    Generation::ORIENTATION_LABELS.map { |value, label| [label, value] },
                    { selected: generation.orientation.presence || "consultant" },
                    class: "cf-input" %>
      <p class="studio-field-hint">Change le ton et l'appel à l'action des posts LinkedIn, des actus et des articles.</p>
    </div>

    <div class="d-none" data-studio-generation-target="realisationField">
      <div class="cf-field">
        <%= f.label :realisation_id, "Réalisation à mettre en avant (optionnel)", class: "cf-label" %>
        <%= f.select :realisation_id,
                      options_for_select(
                        [["Laisser l'IA choisir", ""]] +
                        RealisationCatalog::ITEMS.map { |r| ["#{r[:id]} — #{r[:titre]}", r[:id]] },
                        generation.realisation_id
                      ), {}, class: "cf-input" %>
        <p class="studio-field-hint">
          Si tu colles une source ou un brief, l'IA choisit elle-même la réalisation la plus pertinente — ce
          sélecteur n'impose un choix que pour les posts générés sans source.
        </p>
      </div>

      <% if local_assigns.fetch(:show_generate_visual_option, false) %>
        <div class="cf-field cf-field--checkbox">
          <label>
            <%= f.check_box :generate_visual %>
            Générer aussi un visuel juste après le texte
          </label>
        </div>
        <div class="cf-field">
          <%= f.select :image_model,
                        Generation::IMAGE_MODELS.map { |value, label| [label, value] },
                        { selected: generation.image_model }, class: "cf-input" %>
          <p class="studio-field-hint">Modèle utilisé si tu coches la case ci-dessus.</p>
        </div>
      <% end %>
    </div>

    <div class="cf-field">
      <%= f.label :extra_instructions, "Instructions complémentaires (optionnel)", class: "cf-label" %>
      <%= f.text_area :extra_instructions, class: "cf-input cf-textarea", rows: 3, placeholder: "Ton à adopter, points à mettre en avant…" %>
    </div>
  </div>

  <div class="studio-card">
    <h2 class="studio-card-subtitle">4. Titre (optionnel)</h2>
    <div class="cf-field">
      <%= f.text_field :title, class: "cf-input", placeholder: "Donne un nom à cette génération" %>
    </div>
  </div>

  <div class="studio-card">
    <h2 class="studio-card-subtitle">5. Modèle IA</h2>
    <div class="cf-field">
      <%= f.select :llm_model,
                    Generation::LLM_MODELS.map { |value, label| [label, value] },
                    { selected: generation.llm_model.presence || Generation::DEFAULT_LLM_MODEL },
                    class: "cf-input" %>
      <p class="studio-field-hint">Gemini par défaut : rapide et suffisant pour un premier jet. À changer si le résultat déçoit.</p>
    </div>
  </div>

  <%# Le dernier geste avant de générer une note de diagnostic : coller l'analyse qui vient d'être
      validée dans l'autre outil, puis le bouton juste dessous. Facultatif — vide, la note se
      construit sur les signaux publics du brief ; remplie, elle est la seule source de chiffres. %>
  <div class="studio-card <%= "d-none" unless generation.executive_brief? %>"
       data-studio-generation-target="kindField" data-kinds="executive_brief">
    <h2 class="studio-card-subtitle">6. Analyse financière (optionnel)</h2>
    <div class="cf-field">
      <%= f.text_area :financial_analysis, class: "cf-input cf-textarea", rows: 10,
                      placeholder: "Colle ici l'analyse financière validée (texte ou markdown)" %>
      <p class="studio-field-hint">
        Vide : la note se construit sur les signaux publics du brief. Remplie : elle devient la
        <strong>seule source de chiffres</strong>, chacun relu automatiquement contre elle.
      </p>
    </div>
  </div>

  <div class="studio-actions">
    <%= link_to "Annuler", studio_generations_path, class: "btn-cp-outline" %>
    <%= f.submit submit_label, class: "btn-cp-primary", data: { studio_generation_target: "submitButton" } %>
  </div>
<% end %>
