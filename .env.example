# Template des variables d'environnement — à copier vers `.env` puis remplir.
# Aucune valeur réelle ici : ce fichier est committé, `.env` ne l'est jamais.
#
#   cp .env.example .env
#
# En production, ces variables sont posées sur Heroku (`heroku config:set NOM=valeur`).

# --- LLM (Mammouth.ai) -------------------------------------------------------
# Fournisseur unique pour le Studio (génération, relecture, visuels) et le chatbot
# du formulaire de contact. Endpoint OpenAI-compatible.
MAMMOUTH_API_KEY=

# --- Stockage des fichiers (Active Storage) ----------------------------------
# Obligatoire en production : le disque Heroku est éphémère.
# Si absente en développement, l'app retombe sur le stockage local.
# Format : cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Active Record Encryption ------------------------------------------------
# Chiffre User#linkedin_access_token. À générer UNE FOIS avec :
#   bin/rails db:encryption:init
# Les changer rend illisibles les données déjà chiffrées.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Publication LinkedIn (OAuth2) -------------------------------------------
# App LinkedIn : penser à déclarer les DEUX URLs de callback (avec et sans www),
# le domaine nu redirigeant vers www.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Envoi d'emails (SMTP Gmail) ---------------------------------------------
# GMAIL_PASSWORD = mot de passe d'application, pas le mot de passe du compte.
GMAIL_USERNAME=
GMAIL_PASSWORD=

# --- Compte administrateur initial (db/seeds.rb) -----------------------------
# Les inscriptions Devise sont désactivées : le premier compte se crée par les seeds.
# Si ces variables sont vides, le seed est simplement ignoré.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Monitoring (optionnel) --------------------------------------------------
# Sentry ne s'initialise que si cette variable est présente : la laisser vide en
# développement pour qu'aucune erreur locale ne remonte.
SENTRY_DSN=
